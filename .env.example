# --- Database -------------------------------------------------------------
# Postgres connection string used by the app and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Admin APIs ------------------------------------------------------------
# Bearer token required by GET /api/enquiry and POST /api/gallery.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# --- Public site -----------------------------------------------------------
# Used for canonical URLs, Open Graph tags and JSON-LD. On Vercel the
# production URL is detected automatically; set this only for custom domains.
NEXT_PUBLIC_SITE_URL=https://aari-work-web.vercel.app

# --- Analytics (optional) --------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# --- Gallery images --------------------------------------------------------
# Comma-separated https hosts the admin gallery API may store images from.
# These must also be present at build time so next/image accepts them.
# Example: GALLERY_IMAGE_HOSTS=cdn.example.com,res.cloudinary.com
GALLERY_IMAGE_HOSTS=
